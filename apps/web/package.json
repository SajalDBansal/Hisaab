    "@repo/eslint-config": "*",
    "@repo/typescript-config": "*",
    "@types/node": "^24.0.0",
    "@types/react": "~19.2.10",
    "@types/react-dom": "^19.2.0",
    "eslint": "^9.39.0",
    "typescript": "5.9.2"
  }
