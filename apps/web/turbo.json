{
  "$schema": "https://turborepo.dev/schema.json",
  "extends": ["//"],
  "tasks": {
    "build": {
      "env": [
        "NEXT_PUBLIC_SITE_URL",
        "NEXT_PUBLIC_APP_URL",
        "NEXT_PUBLIC_SUPPORT_EMAIL",
        "NEXT_PUBLIC_DOWNLOAD_MANIFEST_URL"
      ]
    },
    "dev": {
      "cache": false,
      "persistent": true,
      "passThroughEnv": [
        "NEXT_PUBLIC_SITE_URL",
        "NEXT_PUBLIC_APP_URL",
        "NEXT_PUBLIC_SUPPORT_EMAIL",
        "NEXT_PUBLIC_DOWNLOAD_MANIFEST_URL"
      ]
    }
  }
}
