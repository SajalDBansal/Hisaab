# Copy to .env.local for local Expo work. Real phones cannot use localhost.
#
# Physical phone on same Wi-Fi:
# EXPO_PUBLIC_API_URL=http://192.168.1.224:3000
#
# Android emulator:
# EXPO_PUBLIC_API_URL=http://10.0.2.2:3000
#
# iOS simulator:
# EXPO_PUBLIC_API_URL=http://localhost:3000

# Leave blank to let the app derive the API host from Expo's LAN URL.
EXPO_PUBLIC_API_URL=

# Localhost web automatically uses localhost with the same API port.
# Optional explicit web endpoint when the API runs on a different machine.
EXPO_PUBLIC_WEB_API_URL=

# Set false only when designing screens without a backend session.
EXPO_PUBLIC_REQUIRE_LOGIN=true
