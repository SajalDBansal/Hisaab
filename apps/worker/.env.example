# Copy to apps/worker/.env. Use the same DB, Redis and PRIVATE document bucket as the API.
NODE_ENV=development
DATABASE_URL=postgresql://hisaab:hisaab@localhost:55432/hisaab
REDIS_URL=redis://localhost:16379
LOG_LEVEL=info
WORKER_HEALTH_PORT=3011
# Local Windows example: C:/Program Files (x86)/Microsoft/Edge/Application/msedge.exe
# Set this to an installed Chromium or Edge executable for PDF generation.
PDF_BROWSER_PATH=
AWS_REGION=ap-south-1
S3_BUCKET=
R2_ACCOUNT_ID=
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_ENDPOINT=
SENTRY_DSN=
SENTRY_ENVIRONMENT=
SENTRY_RELEASE=
SENTRY_TRACES_SAMPLE_RATE=0

# Whole-database backups: separate PRIVATE R2 bucket; initialize with the host backup command.
BACKUP_ENABLED=false
BACKUP_INSTALLATION_ID=
BACKUP_WRITER_ID=
BACKUP_R2_BUCKET=
BACKUP_R2_ENDPOINT=
BACKUP_R2_ACCESS_KEY_ID=
BACKUP_R2_SECRET_ACCESS_KEY=
# Optional HTTPS success ping for an external 02:00 Asia/Kolkata monitor (keep its URL secret).
BACKUP_HEARTBEAT_URL=
