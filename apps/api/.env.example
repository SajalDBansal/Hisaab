# Copy to .env for local work. Real values never go in git.
NODE_ENV=development
APP_MODE=normal
HOST=0.0.0.0
PORT=3000
# Set only the actual reverse-proxy addresses in deployment; empty trusts none.
TRUSTED_PROXY_CIDRS=
LOG_LEVEL=debug
# Local PostgreSQL example; configure the database separately.
DATABASE_URL=postgres://hisaab:hisaab@localhost:55432/hisaab
# Local Redis example for rate limits and queues; configure Redis separately.
REDIS_URL=redis://localhost:16379
# Signs sessions and codes. Make one with: openssl rand -base64 32
BETTER_AUTH_SECRET=change-me-to-a-long-random-string-32-chars
BETTER_AUTH_URL=http://localhost:3000
# Websites and app schemes allowed to call the API (comma separated).
# Add your LAN Expo origin too when using a physical phone, e.g. http://192.168.1.224:8081
TRUSTED_ORIGINS=http://localhost:8081,http://localhost:19006,hisaab://
# Leave RESEND_API_KEY empty in development: codes are printed in this server's log instead
RESEND_API_KEY=
EMAIL_FROM=Hisaab <onboarding@resend.dev>
# Private document storage. Without storage credentials, uploads return a clear setup error.
# Cloudflare R2 credentials stay on the API server, never in EXPO_PUBLIC variables.
R2_ACCOUNT_ID=
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# Optional override for a jurisdiction-specific R2 endpoint.
R2_ENDPOINT=
# Browser/PDF runtime settings belong in apps/worker/.env, not this API env.
# Per-firm document capacity, including upload reservations and preview allowance.
DOCUMENT_STORAGE_MAX_BYTES=1073741824
DOCUMENT_STORAGE_MAX_FILES=10000
# Legacy AWS S3 fallback (unused when R2_BUCKET is set).
AWS_REGION=ap-south-1
S3_BUCKET=
# Optional Sentry error exporter. Leave blank locally.
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
SENTRY_RELEASE=
SENTRY_TRACES_SAMPLE_RATE=0
