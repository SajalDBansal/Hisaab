{
  "name": "api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Hisaab backend: Fastify + Drizzle + PostgreSQL.",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/server.ts",
    "build": "tsup",
    "start": "node --env-file-if-exists=.env dist/server.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "clean": "rm -rf dist",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --env-file-if-exists=.env src/db/migrate.ts",
    "db:seed": "tsx --env-file-if-exists=.env src/db/seed.ts",
    "db:studio": "drizzle-kit studio"
  },
  "dependencies": {
    "@repo/backend": "*",
    "@aws-sdk/client-s3": "^3.1151.0",
    "@aws-sdk/s3-request-presigner": "^3.1151.0",
    "@better-auth/expo": "^1.7.7",
    "@fastify/compress": "^9.2.2",
    "@fastify/cors": "^11.3.0",
    "@fastify/helmet": "^13.2.0",
    "@fastify/rate-limit": "^11.2.1",
    "@fastify/swagger": "^9.5.0",
    "@fastify/swagger-ui": "^5.2.0",
    "@repo/contracts": "*",
    "@repo/core": "*",
    "@sentry/node": "^11.7.0",
    "better-auth": "^1.7.7",
    "bullmq": "^6.3.15",
    "csv-parse": "^7.0.3",
    "drizzle-orm": "^0.45.3",
    "fastify": "^5.12.6",
    "fastify-type-provider-zod": "^6.0.0",
    "ioredis": "^6.0.0",
    "pg": "^8.23.1",
    "resend": "^6.32.1",
    "sharp": "^0.35.5",
    "uuid": "^14.0.2",
    "zod": "^4.6.6"
  },
  "devDependencies": {
    "@repo/eslint-config": "*",
    "@repo/typescript-config": "*",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.23.1",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9.39.0",
    "pino-pretty": "^13.1.0",
    "tsup": "^8.5.0",
    "tsx": "^4.20.0",
    "typescript": "5.9.2"
  }
}
