# Copy to local.api.env. These defaults use compose.dev.yml alongside compose.local.yml.
# For external services, replace BOTH URLs with addresses reachable from containers.
DATABASE_URL=postgres://hisaab:hisaab@postgres:5432/hisaab
REDIS_URL=redis://redis:6379
BETTER_AUTH_SECRET=local-only-change-me-to-a-random-secret-32-chars
LOG_LEVEL=info
# Empty means verification codes go to local API logs; no email is sent.
RESEND_API_KEY=
EMAIL_FROM=Hisaab <onboarding@resend.dev>
# Optional for local accounting; set all four for real documents/private PDFs.
R2_ACCOUNT_ID=
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_ENDPOINT=
