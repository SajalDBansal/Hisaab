# Copy to api.env beside compose.prod.yml. Replace every placeholder.
# Values are literal: no enclosing quotes, shell substitutions or inline comments.
APP_MODE=normal
# Generate a UUID once; rotate it after every whole-database restore, not every restart.
RECOVERY_EPOCH=REPLACE_WITH_A_RANDOM_UUID
LOG_LEVEL=info
# Production Compose supplies DATABASE_URL and REDIS_URL from its private .env.
# Configure POSTGRES_PASSWORD and REDIS_PASSWORD there, not duplicate URLs here.
# This example is intentionally rejected by production validation.
BETTER_AUTH_SECRET=replace-me-with-a-stable-random-secret-before-production
BETTER_AUTH_URL=https://api.hisaab.sajaldbansal.com
TRUSTED_ORIGINS=https://app.hisaab.sajaldbansal.com,hisaab://
RESEND_API_KEY=REPLACE_WITH_RESEND_KEY
EMAIL_FROM=Hisaab <REPLACE_WITH_YOUR_VERIFIED_SENDER>
R2_ACCOUNT_ID=REPLACE_WITH_ACCOUNT_ID
R2_BUCKET=REPLACE_WITH_PRIVATE_BUCKET
R2_ACCESS_KEY_ID=REPLACE_WITH_ACCESS_KEY
R2_SECRET_ACCESS_KEY=REPLACE_WITH_SECRET_KEY
R2_ENDPOINT=
