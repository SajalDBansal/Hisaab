# Copy to realtime.env beside compose.prod.yml. The live service gets only these
# settings: no session, email or storage secrets.
LOG_LEVEL=info
# Production Compose supplies DATABASE_URL and REDIS_URL from its private .env.
# The SAME value as LIVE_TICKET_SECRET in api.env. Make one with: openssl rand -base64 32
LIVE_TICKET_SECRET=replace-me-with-the-same-secret-as-api-env
# Web pages allowed to open a live connection. Apps send no Origin.
TRUSTED_ORIGINS=https://app.hisaab.sajaldbansal.com
