# Build from the repository root with --platform linux/amd64.
# Official Node/Bun image digests reviewed on 2026-10-26.
FROM node:24.22.1-bookworm-slim@sha256:55fb5f5a527ea2c5c4a95f963e48ef90aa38c7b346054fdc8ee9957a2b55d205 AS build
COPY --from=oven/bun:1.4.0@sha256:5ff609364c049b54eb0ff560ec96319729a972078ef2c755d758f0c6ef89c2d6 /usr/local/bin/bun /usr/local/bin/bun
WORKDIR /app
COPY . .
RUN --mount=type=cache,target=/root/.bun/install/cache bun install --frozen-lockfile
RUN bun run --cwd apps/worker build

FROM node:24.22.1-bookworm-slim@sha256:55fb5f5a527ea2c5c4a95f963e48ef90aa38c7b346054fdc8ee9957a2b55d205 AS runtime
# Debian bookworm defaults to client 15; backups must use PostgreSQL 17 tools.
# Use the official PGDG repository with its dedicated signing key.
RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates curl \
    && install -d /usr/share/postgresql-common/pgdg \
    && curl --fail --show-error --silent --retry 3 --connect-timeout 10 --max-time 60 \
        https://www.postgresql.org/media/keys/ACCC4CF8.asc \
        -o /usr/share/postgresql-common/pgdg/apt.postgresql.org.asc \
    && printf '%s\n' \
        'Types: deb' \
        'URIs: https://apt.postgresql.org/pub/repos/apt' \
        'Suites: bookworm-pgdg' \
        'Components: main' \
        'Signed-By: /usr/share/postgresql-common/pgdg/apt.postgresql.org.asc' \
        > /etc/apt/sources.list.d/pgdg.sources \
    && apt-get update \
    && apt-get install -y --no-install-recommends \
        postgresql-client-17 chromium chromium-sandbox fonts-liberation fonts-noto-core fonts-noto-color-emoji \
    && /usr/lib/postgresql/17/bin/pg_dump --version \
    && /usr/lib/postgresql/17/bin/pg_restore --version \
    && apt-get purge -y --auto-remove curl \
    && rm -rf /var/lib/apt/lists/*
ENV PATH="/usr/lib/postgresql/17/bin:${PATH}"
ENV NODE_ENV=production PDF_BROWSER_PATH=/usr/bin/chromium WORKER_HEALTH_PORT=3011
# Keep the complete Linux workspace so Bun's isolated dependency links resolve.
COPY --from=build --chown=node:node /app /app
WORKDIR /app/apps/worker
USER node
# Chromium keeps its sandbox; /tmp is writable and Compose supplies init and shm.
CMD ["node", "dist/worker.js"]
