# Copy to .env beside compose.prod.yml on EC2; chmod 600 and never commit it.
DOCKERHUB_USERNAME=YOUR_DOCKERHUB_USERNAME
IMAGE_TAG=FULL_PUBLISHED_GIT_COMMIT_SHA

# Generate TWO different values with: openssl rand -hex 32
# Use 64 hexadecimal characters so passwords are safe inside connection URLs.
# Compose supplies the database URLs to API and worker from these passwords.
POSTGRES_PASSWORD=
REDIS_PASSWORD=
# Keep these stable: changing this file does not rotate an existing DB password.
