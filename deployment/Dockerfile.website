# Build from the repository root with --platform linux/amd64.
# Official Node/Bun image digests reviewed on 2026-10-26.
FROM node:24.22.1-bookworm-slim@sha256:55fb5f5a527ea2c5c4a95f963e48ef90aa38c7b346054fdc8ee9957a2b55d205 AS build
COPY --from=oven/bun:1.4.0@sha256:5ff609364c049b54eb0ff560ec96319729a972078ef2c755d758f0c6ef89c2d6 /usr/local/bin/bun /usr/local/bin/bun
WORKDIR /app
COPY . .
RUN --mount=type=cache,target=/root/.bun/install/cache bun install --frozen-lockfile

# These are public build settings. Never pass credentials as build arguments.
ARG NEXT_PUBLIC_SITE_URL=https://hisaab.sajaldbansal.com
ARG NEXT_PUBLIC_APP_URL=https://app.hisaab.sajaldbansal.com
ARG NEXT_PUBLIC_SUPPORT_EMAIL=sajaldutt.bansal@gmail.com
ARG NEXT_PUBLIC_DOWNLOAD_MANIFEST_URL=
ENV NEXT_PUBLIC_SITE_URL=$NEXT_PUBLIC_SITE_URL \
    NEXT_PUBLIC_APP_URL=$NEXT_PUBLIC_APP_URL \
    NEXT_PUBLIC_SUPPORT_EMAIL=$NEXT_PUBLIC_SUPPORT_EMAIL \
    NEXT_PUBLIC_DOWNLOAD_MANIFEST_URL=$NEXT_PUBLIC_DOWNLOAD_MANIFEST_URL \
    NEXT_TELEMETRY_DISABLED=1
RUN bun run --cwd apps/web build

FROM node:24.22.1-bookworm-slim@sha256:55fb5f5a527ea2c5c4a95f963e48ef90aa38c7b346054fdc8ee9957a2b55d205 AS runtime
ENV NODE_ENV=production NEXT_TELEMETRY_DISABLED=1
# Next's normal server needs .next, public, config and the workspace dependencies.
COPY --from=build --chown=node:node /app /app
WORKDIR /app/apps/web
USER node
EXPOSE 3002
CMD ["node", "node_modules/next/dist/bin/next", "start", "--hostname", "0.0.0.0", "--port", "3002"]
