# Copy to worker.env beside compose.prod.yml. Match api.env's service credentials.
LOG_LEVEL=info
# Production Compose supplies DATABASE_URL and REDIS_URL from its private .env.
# API and worker automatically use the same internal PostgreSQL and Redis.
R2_ACCOUNT_ID=REPLACE_WITH_ACCOUNT_ID
R2_BUCKET=REPLACE_WITH_PRIVATE_BUCKET
R2_ACCESS_KEY_ID=REPLACE_WITH_ACCESS_KEY
R2_SECRET_ACCESS_KEY=REPLACE_WITH_SECRET_KEY
R2_ENDPOINT=

# Whole-database backups: separate PRIVATE R2 bucket; initialize with the host backup command.
BACKUP_ENABLED=false
BACKUP_INSTALLATION_ID=
BACKUP_WRITER_ID=
BACKUP_R2_BUCKET=
BACKUP_R2_ENDPOINT=
BACKUP_R2_ACCESS_KEY_ID=
BACKUP_R2_SECRET_ACCESS_KEY=
# Optional HTTPS success ping for an external 02:00 Asia/Kolkata monitor (keep its URL secret).
BACKUP_HEARTBEAT_URL=
